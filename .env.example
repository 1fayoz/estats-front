# Backend API base URL.
# Lokal:  http://127.0.0.1:8000/api/v1
# Prod:   https://api.estats.uz/api/v1  (front estats.uz da, API alohida subdomenda)
#
# Diqqat: NEXT_PUBLIC_* qiymatlari BUILD vaqtida bundle'ga inline bo'ladi,
# ya'ni konteynerni ishga tushirishda o'zgartirib bo'lmaydi.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Google Sign-In client id (Google Cloud > APIs > Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
